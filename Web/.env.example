# Copy to Web/.env or Web/.env.local and fill in values.
# Next.js loads both from the Web/ directory (`.env.local` overrides `.env`).
#
# Required for code analysis API routes (OpenAI key, or OpenRouter key with base below):
OPENAI_API_KEY=
# Default: OpenAI. For OpenRouter + Qwen 2.5 instruct, uncomment both lines and use your OpenRouter key above:
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_MODEL=qwen/qwen-2.5-7b-instruct
OPENAI_MODEL=gpt-4o-mini
# Optional OpenRouter attribution headers:
# OPENROUTER_HTTP_REFERER=https://yoursite.example
# OPENROUTER_APP_TITLE=GenGuard

# Optional lock for POST /api/guardmesh/run/* (read-file, code-analysis, query-db).
# If you set a non-empty value here, every request must include:
#   Authorization: Bearer <exactly this string>
# Generate one (Git Bash / WSL):  openssl rand -hex 32
# Use the same string in Policy editor → Save local tool settings (browser) so the dashboard can call run APIs.
GUARDMESH_TOOL_SECRET=
# Localhost only: same string as GUARDMESH_TOOL_SECRET so the Policies page can call kv-sync / run APIs
# without pasting into "Save local tool settings". Exposed in the browser bundle — omit in production.
# NEXT_PUBLIC_GUARDMESH_TOOL_SECRET=

# Sandbox root for read_file / code_analysis paths (optional; defaults to parent of Web/)
# GUARDMESH_WORKSPACE_ROOT=C:\path\to\repo

# For query_db tool route only:
# MONGODB_URI=

# --- GuardMesh intent API (AXL hub must match listeners) ---
# Hub URL used by POST /api/guardmesh/intent (localhost only in bridge code):
GUARDMESH_AXL_URL=http://127.0.0.1:9002
# Comma-separated guardian peer public keys (from each listener banner or from hub /topology).
# If unset, peers are taken from GET {GUARDMESH_AXL_URL}/topology (may be order-unstable).
# Generate a ready-to-paste line:  cd guardmesh-guardian && node print-axl-peer-env.mjs
# GUARDMESH_GUARDIAN_PEER_IDS=key1,key2,key3
# Optional intent poll timeout (ms), clamped in route: 3000–120000
# GUARDMESH_INTENT_TIMEOUT_MS=25000
# Consensus: phase5 (default 3-guardian table), unanimous, majority, any — or 1/2/3 (THRESHOLD codes)
# GUARDMESH_CONSENSUS_THRESHOLD=phase5
#
# Default agent / role for POST /api/guardmesh/intent when JSON omits or blanks them (Policies-registered id).
# GUARDMESH_DEFAULT_AGENT_ID=suguagent.eth
# GUARDMESH_DEFAULT_ROLE_SCOPE=openclaw_guardmesh
#
# Verdict spool path (hub guardian listener competes with Next for /recv; verdicts are replayed from this file).
# Default: ../guardmesh-guardian/.verdict-spool.ndjson relative to Web cwd — override if needed:
# GUARDMESH_VERDICT_SPOOL_PATH=C:\path\to\open\guardmesh-guardian\.verdict-spool.ndjson

# --- Phase 6: 0G Storage (TS SDK) + GuardMeshAudit.recordDecision ---
# Docs: https://docs.0g.ai — use Turbo indexer + evmrpc-testnet for Galileo.
# When enabled, POST /api/guardmesh/intent bundles intent+verdicts+consensus, uploads via @0gfoundation/0g-ts-sdk,
# then anchors the file Merkle root on-chain (same wallet must be an authorized recorder on GuardMeshAudit).
# NOTE: Registering an agent in Policies only updates the on-chain registry — guardian mesh consensus still requires
# the AXL hub + guardian listeners running. If Phase 6 is slow or failing, set GUARDMESH_PHASE6_ANCHOR=0 while
# debugging `verdicts` / `consensus`; the intent route still returns those before Phase 6 runs.
# GUARDMESH_PHASE6_ANCHOR=1
# GUARDMESH_AUDIT_RECORDER_PRIVATE_KEY=0x...   # funded on Galileo; authorized on audit contract
# Optional: override RPC (defaults to NEXT_PUBLIC_0G_RPC_URL or built-in Galileo RPC)
# GUARDMESH_0G_EVM_RPC_URL=https://evmrpc-testnet.0g.ai
# Indexer: omit to use Turbo testnet; or set explicitly / switch mode:
# GUARDMESH_0G_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
# GUARDMESH_0G_STORAGE_MODE=turbo
# GUARDMESH_0G_STORAGE_MODE=standard
# Symmetric AES-256 key (64 hex chars, no 0x) — wraps bundle with SDK newSymmetricEncryptedFile before upload.
# Omit for plaintext JSON upload (dev only; not confidential).
# GUARDMESH_STORAGE_SYMMETRIC_KEY_HEX=
# Optional override for audit contract (else NEXT_PUBLIC_AUDIT_ADDRESS / baked-in testnet deploy)
# GUARDMESH_AUDIT_CONTRACT_ADDRESS=0x522748669646A1a099474cd7f98060968A80E812

# --- Phase 7: 0G KV policy (optional deployment wiring, not missing code) ---
# Omit all KV vars for chain-only policy (guardians: leave GUARDMESH_KV_NODE_URL unset).
# When you enable KV: you must supply your own KV node HTTP RPC — 0G publishes endpoints per network;
# see https://docs.0g.ai (Storage CLI: kv-read --node …). Same URL on Web + every guardian.
# Writes use TS SDK Batcher + storage indexer (like `0g-storage-client kv-write --indexer ...`).
# After on-chain policy changes, Policies UI calls `POST /api/guardmesh/kv-sync` (reads `getPolicy` then writes KV — no drift).
# Manual / CI: same endpoint or `POST /api/guardmesh/kv-policy` with a full JSON body.
# Reads in guardians use a KV *node* RPC URL (like `kv-read --node ...`) — see 0G Storage docs.
# GUARDMESH_KV_WRITER_PRIVATE_KEY=0x...   # Galileo-funded key; not exposed to the browser
# If unset: `next.config.mjs` copies PRIVATE_KEY from ../0g-contracts/.env; else kv-write falls back to GUARDMESH_AUDIT_RECORDER_PRIVATE_KEY.
# GUARDMESH_KV_STREAM_ID=1   # decimal or full 0x…64 hex (normalized to bytes32 for the 0G TS SDK)
# GUARDMESH_KV_NODE_URL=https://...     # KV node HTTP RPC for GET /api/guardmesh/kv-policy and for guardians
#
# On each guardian `.env`: if `GUARDMESH_KV_NODE_URL` is set, policy **must** be read from 0G KV (no chain fallback).
# Leave `GUARDMESH_KV_NODE_URL` unset only for local dev without KV.
# GUARDMESH_KV_NODE_URL=<same as Web>
# GUARDMESH_KV_STREAM_ID=1
