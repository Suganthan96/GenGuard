# 0G Network Configuration

PRIVATE_KEY=your_private_key_here

PROVIDER_ADDRESS=0xa48f01287233509FD694a22Bf840225062E67836

RPC_URL=https://evmrpc-testnet.0g.ai



# Guardian Configuration (unique per instance: guardian-1, guardian-2, guardian-3)
# start-guardian-listener.js loads `.env.<id>` when present (e.g. `.env.guardian-2` for guardian-2).

GUARDIAN_ID=guardian-1

AXL_API_URL=http://127.0.0.1:9002



# Consensus (align with Web GUARDMESH_CONSENSUS_THRESHOLD)

CONSENSUS_THRESHOLD=majority



# On-chain policy gate — GuardMeshRegistry (see 0g-contracts/deployments/testnet.json)

GUARDMESH_REGISTRY_ADDRESS=0x0bfB6f131A99D5aaA3071618FFBD5bb3ea87C619

# Set to 1 to skip registry reads (LLM-only guardians)

# GUARDMESH_REGISTRY_DISABLE=1



# --- 0G KV (optional): unset = chain-only policy; set = KV-only (no chain fallback for policy fields) ---
# GUARDMESH_KV_NODE_URL must be a KV *node* RPC (not the storage indexer). Per-network URLs: 0G docs.

# GUARDMESH_KV_STREAM_ID=1

# GUARDMESH_KV_NODE_URL=



# --- OpenAI LLM (optional alternative to 0G Compute) ---
# Set GUARDMESH_USE_OPENAI_LLM=1 to use OpenAI instead of 0G Compute for verdict generation.
# This allows you to test the mesh without spending 0G tokens.
# Verdict format is the same (role_check, permission_check, content_check, verdict, reason).

# GUARDMESH_USE_OPENAI_LLM=1

# OPENAI_API_KEY=sk-...

# OPENAI_MODEL=gpt-4-turbo

# OPENAI_API_ENDPOINT=https://api.openai.com/v1/chat/completions


