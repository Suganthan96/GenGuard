# Copy to `.env` in this folder or export in your shell before running mesh-then-openclaw-invoke.mjs
#
# GuardMesh intent bridge (Next Web or deployed host)
GUARDMESH_BRIDGE_URL=http://127.0.0.1:3000/api/guardmesh/intent

# OpenClaw Gateway (when plan includes "invoke")
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# Optional: server-side enterprise channel guard for /api/guardmesh/run/openclaw-agent
# JSON object keyed by: msteams, slack, mattermost, matrix, feishu
# Example:
# OPENCLAW_ENTERPRISE_CHANNEL_POLICY_JSON={"msteams":{"enabled":true,"dmPolicy":"pairing","groupPolicy":"allowlist","requireMention":true,"allowedUsers":["user-aad-id"],"allowedGroups":["team-or-channel-id"]}}
OPENCLAW_ENTERPRISE_CHANNEL_POLICY_JSON=
